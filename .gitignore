# nexus-wireguard .gitignore
# Sensitive cryptographic material and configs - NEVER commit real keys or live configs
*.key
*.pem
wg*.conf
private/
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Rust / Cargo
/target/
**/*.rs.bk
Cargo.lock

# Docker
.dockerignore
.env
.env.*
docker-compose.override.yml

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs and temp
*.log
*.tmp
*.bak

# Yggdrasil / Nexus related (if local test data)
yggdrasil.*
qnet.*

# Keep example templates
!configs/example/*.conf
!configs/example/*.key.pub